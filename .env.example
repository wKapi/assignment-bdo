# LLM პროვაიდერი: mock | anthropic
# `mock` — გასაღები არ სჭირდება და სრულად მუშაობს.
LLM_PROVIDER=mock

# Anthropic Claude API — საჭიროა მხოლოდ LLM_PROVIDER=anthropic-ისთვის
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# „დღევანდელი“ თარიღი — 2026-10-19.
# ყველა ვადა ამ თარიღზე ითვლება და date.today() არ გამოიყენება.
APP_TODAY=2026-10-19

# აქტიური სესია — MCP სერვერი ამ ცვლადებით ცნობს მომხმარებელს
CURRENT_EMPLOYEE_ID=E1001
CURRENT_ROLE=employee
